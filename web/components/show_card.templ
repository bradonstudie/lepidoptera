package components

import "github.com/bradonstudie/lepidoptera/internal/viewmodels"

templ ShowCard(show viewmodels.ShowListViewModel) {
	<article class="show-card">
		<div class="show-card__venue">{ show.Venue }</div>
		<div class="show-card__body">
			<h2 class="show-card__title">
				<a href={ templ.SafeURL("/shows/" + show.Slug) }>{ show.Title }</a>
			</h2>
		</div>
		<div class="show-card__meta">
			<time class="show-card__date">{ show.Date }</time>
			if show.HasTicket {
				<a href={ templ.SafeURL(show.TicketURL) } class="show-card__tickets">tickets →</a>
			}
		</div>
	</article>
}

templ ShowList(shows []viewmodels.ShowListViewModel) {
	if len(shows) == 0 {
		<p class="empty">no shows found.</p>
	} else {
		for _, show := range shows {
			@ShowCard(show)
		}
	}
}
