package pages

import (
	db "github.com/lepidoptera/lepidoptera/internal/db/generated"
	"github.com/lepidoptera/lepidoptera/web/components"
	"github.com/lepidoptera/lepidoptera/web/layouts"
)

templ Index(shows []db.ListPublishedShowsRow, genres []string) {
	@layouts.Base("upcoming shows") {
		<section class="shows">
			<header class="shows__header">
				<h1>upcoming shows</h1>
				if len(genres) > 0 {
					<div class="shows__filters">
						<select
							name="genre"
							hx-get="/"
							hx-target="#show-list"
							hx-swap="innerHTML"
							hx-trigger="change"
						>
							<option value="">all genres</option>
							for _, g := range genres {
								<option value={ g }>{ g }</option>
							}
						</select>
					</div>
				}
			</header>
			<div id="show-list">
				@components.ShowList(shows)
			</div>
		</section>
	}
}

templ ShowList(shows []db.ListPublishedShowsRow) {
	<p class="empty">no shows found.</p>
}
