package admin

import (
	db "github.com/lepidoptera/lepidoptera/internal/db/generated"
	"github.com/lepidoptera/lepidoptera/web/layouts"
	"github.com/lepidoptera/lepidoptera/internal/timeutil"
)

templ Dashboard(shows []db.ListAllShowsRow) {
	@layouts.Base("admin") {
		<section class="admin">
			<header class="admin__header">
				<h1>admin</h1>
				<form method="POST" action="/admin/logout">
					<button type="submit">logout</button>
				</form>
			</header>
			<nav class="admin__nav">
				<a href="/admin/shows/new">+ new show</a>
				<a href="/admin/bands/new">+ new band</a>
				<a href="/admin/venues/new">+ new venue</a>
			</nav>
			<section class="admin__shows">
				<h2>all shows</h2>
				if len(shows) == 0 {
					<p class="empty">no shows yet.</p>
				} else {
					<table class="admin-table">
						<thead>
							<tr>
								<th>title</th>
								<th>venue</th>
								<th>date</th>
								<th>status</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, show := range shows {
								<tr class="admin-table__row">
									<td>{ show.Title }</td>
									<td>
										if show.VenueName.Valid {
											{ show.VenueName.String }
										}
									</td>
									<td>{ show.Date.Format(timeutil.DisplayDate) }</td>
									<td>
										if show.IsPublished {
											<span class="badge badge--published">published</span>
										} else {
											<span class="badge badge--draft">draft</span>
										}
									</td>
									<td class="admin-table__actions">
										if !show.IsPublished {
											<form method="POST" action={ templ.SafeURL("/admin/shows/" + show.ID.String() + "/publish") }>
												<button type="submit">publish →</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
		</section>
	}
}