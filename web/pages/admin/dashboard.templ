package admin

import "github.com/lepidoptera/lepidoptera/web/layouts"
import "github.com/lepidoptera/lepidoptera/internal/db/generated"

templ Dashboard(shows []db.ListAllShowsRow) {
	@layouts.Base("admin") {
		<section class="admin">
			<header class="admin__header">
				<h1>admin</h1>
				<form method="POST" action="/admin/logout">
					<button type="submit">logout</button>
				</form>
			</header>
			<nav class="admin__nav">
				<a href="/admin/shows/new">+ new show</a>
				<a href="/admin/bands/new">+ new band</a>
				<a href="/admin/venues/new">+ new venue</a>
			</nav>
			<div class="admin__shows">
				<h2>all shows</h2>
				<p>TODO: shows table</p>
			</div>
		</section>
	}
}