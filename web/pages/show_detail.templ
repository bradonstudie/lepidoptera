package pages

import (
	"github.com/lepidoptera/lepidoptera/internal/viewmodels"
	"github.com/lepidoptera/lepidoptera/web/layouts"
)

templ ShowDetail(show viewmodels.ShowDetailViewModel) {
	@layouts.Base(show.Title) {
		<article class="show-detail">
			<header class="show-detail__header">
				<h1 class="show-detail__title">{ show.Title }</h1>
				<div class="show-detail__meta">
					<time>{ show.Date }</time>
					if show.Venue != "" {
						<span class="show-detail__venue">
							{ show.Venue }
							if show.City != "" {
								{ " — " + show.City }
							}
						</span>
					}
				</div>
			</header>
			if show.HasFlyer {
				<div class="show-detail__flyer">
					<img src={ show.FlyerURL } alt={ show.Title + " flyer" }/>
				</div>
			}
			if len(show.Bands) > 0 {
				<section class="show-detail__bill">
					<h2>on the bill</h2>
					for _, band := range show.Bands {
						<div class="bill-row">
							<span class="bill-row__name">{ band.Name }</span>
							if band.Genre != "" {
								<span class="bill-row__genre">{ band.Genre }</span>
							}
							if band.IsHeadliner {
								<span class="bill-row__headliner">headliner</span>
							}
							if band.Description != "" {
								<p class="bill-row__description">{ band.Description }</p>
							}
						</div>
					}
				</section>
			}
			if show.Description != "" {
				<section class="show-detail__description">
					<p>{ show.Description }</p>
				</section>
			}
			if show.HasTicket {
				<div class="show-detail__tickets">
					<a href={ templ.SafeURL(show.TicketURL) } class="btn">get tickets →</a>
				</div>
			}
		</article>
	}
}
